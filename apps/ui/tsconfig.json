{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/components/ui/*": ["../../packages/web/components/ui/*"],
      "@/components/patterns/*": ["../../packages/web/components/patterns/*"],
      "@/components/interactions/*": [
        "../../packages/web/components/interactions/*"
      ],
      "@/components/charts/*": ["../../packages/web/components/charts/*"],
      "@/components/blocks/*": ["../../packages/web/components/blocks/*"],
      "@/hooks/*": ["../../packages/web/hooks/*"],
      "@/*": ["./*"],
      "storybook/test": ["./lib/storybook/test.ts"],
      "@storybook/react-vite": ["./lib/storybook/react-vite.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
