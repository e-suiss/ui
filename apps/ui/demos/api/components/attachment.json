{
  "name": "attachment",
  "type": "ui",
  "files": [
    "components/ui/attachment.tsx"
  ],
  "requires": [
    "button"
  ],
  "dependencies": [
    "@base-ui/react",
    "class-variance-authority",
    "cn"
  ],
  "examples": [
    "Default",
    "Sizes",
    "States",
    "Image",
    "Vertical",
    "Clickable",
    "Group",
    "FileTypes",
    "FileList",
    "Uploaded"
  ],
  "parts": [
    {
      "name": "Attachment",
      "extends": [
        "React.ComponentProps<\"div\">"
      ],
      "props": [
        {
          "name": "size",
          "type": "\"default\" | \"sm\" | \"xs\"",
          "default": "\"default\"",
          "required": false
        },
        {
          "name": "orientation",
          "type": "\"horizontal\" | \"vertical\"",
          "default": "\"horizontal\"",
          "required": false
        },
        {
          "name": "state",
          "type": "\"idle\" | \"uploading\" | \"processing\" | \"error\" | \"done\"",
          "required": false,
          "default": "\"done\""
        }
      ]
    },
    {
      "name": "AttachmentLabel",
      "extends": [
        "React.ComponentProps<\"span\">"
      ],
      "props": []
    },
    {
      "name": "AttachmentMedia",
      "extends": [
        "React.ComponentProps<\"div\">"
      ],
      "props": [
        {
          "name": "variant",
          "type": "\"icon\" | \"document\" | \"image\"",
          "default": "\"icon\"",
          "required": false
        }
      ]
    },
    {
      "name": "AttachmentContent",
      "extends": [
        "React.ComponentProps<\"div\">"
      ],
      "props": []
    },
    {
      "name": "AttachmentTitle",
      "extends": [
        "React.ComponentProps<\"span\">"
      ],
      "props": []
    },
    {
      "name": "AttachmentDescription",
      "extends": [
        "React.ComponentProps<\"span\">"
      ],
      "props": []
    },
    {
      "name": "AttachmentProgress",
      "extends": [
        "ProgressPrimitive.Root.Props"
      ],
      "props": []
    },
    {
      "name": "AttachmentActions",
      "extends": [
        "React.ComponentProps<\"div\">"
      ],
      "props": []
    },
    {
      "name": "AttachmentAction",
      "extends": [
        "React.ComponentProps<typeof Button>"
      ],
      "props": []
    },
    {
      "name": "AttachmentTrigger",
      "extends": [
        "useRender.ComponentProps<\"button\">"
      ],
      "props": []
    },
    {
      "name": "AttachmentGroup",
      "extends": [
        "React.ComponentProps<\"div\">"
      ],
      "props": []
    }
  ]
}
