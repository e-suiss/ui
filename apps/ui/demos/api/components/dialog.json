{
  "name": "dialog",
  "type": "ui",
  "files": [
    "components/ui/dialog.tsx"
  ],
  "requires": [
    "button"
  ],
  "dependencies": [
    "@base-ui/react",
    "@phosphor-icons/react",
    "cn"
  ],
  "examples": [
    "Default",
    "WithoutCloseButton",
    "Destructive"
