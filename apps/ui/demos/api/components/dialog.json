  "parts": [
    {
      "name": "Dialog",
      "extends": [
        "DialogPrimitive.Root.Props"
      ],
      "props": []
    },
    {
      "name": "DialogTrigger",
      "extends": [
        "DialogPrimitive.Trigger.Props"
      ],
      "props": []
    },
    {
      "name": "DialogPortal",
      "extends": [
        "DialogPrimitive.Portal.Props"
      ],
      "props": []
    },
    {
      "name": "DialogClose",
      "extends": [
        "DialogPrimitive.Close.Props"
      ],
      "props": []
    },
    {
      "name": "DialogOverlay",
      "extends": [
        "DialogPrimitive.Backdrop.Props"
      ],
      "props": []
    },
    {
      "name": "DialogContent",
      "extends": [
        "DialogPrimitive.Popup.Props"
      ],
      "props": [
        {
          "name": "showCloseButton",
          "type": "boolean",
          "required": false,
          "default": "true"
        },
        {
