          "required": false
        }
      ]
    },
    {
      "name": "DialogHeader",
      "extends": [
        "React.ComponentProps<\"div\">"
      ],
      "props": []
    },
    {
      "name": "DialogFooter",
      "extends": [
        "React.ComponentProps<\"div\">"
      ],
      "props": [
        {
          "name": "showCloseButton",
          "type": "boolean",
          "required": false,
          "default": "false"
        }
      ]
    },
    {
      "name": "DialogTitle",
      "extends": [
        "DialogPrimitive.Title.Props"
      ],
      "props": []
    },
    {
      "name": "DialogDescription",
      "extends": [
        "DialogPrimitive.Description.Props"
      ],
      "props": []
    }
  ]
}
