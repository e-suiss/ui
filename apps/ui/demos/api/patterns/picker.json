          "type": "string",
          "required": false
        },
        {
          "name": "children",
          "type": "React.ReactNode",
          "required": false
        }
      ]
    },
    {
      "name": "PickerItem",
      "extends": [],
      "props": [
        {
          "name": "value",
          "type": "string",
          "required": true
        },
        {
          "name": "disabled",
          "type": "boolean",
          "required": false
