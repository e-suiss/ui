{
  "name": "picker",
  "type": "pattern",
  "files": [
    "components/patterns/picker.tsx"
  ],
  "requires": [
    "native-select",
    "select",
    "use-mobile"
  ],
  "dependencies": [],
  "examples": [
    "Default",
    "WithValue",
