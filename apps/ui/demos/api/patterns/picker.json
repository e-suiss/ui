        },
        {
          "name": "name",
          "type": "string",
          "required": false
        },
        {
          "name": "disabled",
          "type": "boolean",
          "required": false
        },
        {
          "name": "required",
          "type": "boolean",
          "required": false
        },
        {
          "name": "className",
          "type": "string",
          "required": false
        },
        {
          "name": "children",
          "type": "React.ReactNode",
          "required": false
        },
        {
          "name": "aria-invalid",
          "type": "boolean",
          "required": false
        },
        {
          "name": "aria-label",
          "type": "string",
          "required": false
        },
        {
          "name": "aria-describedby",
          "type": "string",
          "required": false
        }
