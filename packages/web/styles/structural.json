{
  "cn-accordion-trigger": "relative",
  "cn-alert": "w-full",
  "cn-alert-description": "[&_a]:hover:text-foreground",
  "cn-alert-dialog-content": "-translate-x-1/2",
  "cn-alert-dialog-content-aria": "-translate-x-1/2",
  "cn-attachment": "relative",
  "cn-attachment-description": "text-muted-foreground",
  "cn-avatar-fallback": "size-full group-data-[size=sm]/avatar:text-xs",
  "cn-avatar-group": "-space-x-2",
  "cn-badge": "focus-visible:border-ring aria-invalid:border-destructive",
  "cn-bubble-content": "w-fit",
  "cn-carousel-next": "absolute",
  "cn-carousel-previous": "absolute",
  "cn-chart": "[&_.recharts-cartesian-axis-tick_text]:fill-muted-foreground [&_.recharts-layer]:outline-hidden [&_.recharts-sector]:outline-hidden [&_.recharts-surface]:outline-hidden",
  "cn-code-block-actions": "ms-auto",
  "cn-code-block-line": "in-data-numbered:before:content-[counter(line)] in-data-numbered:supports-[content:counter(line)_/_'']:before:content-[counter(line)_/_'']",
  "cn-combobox-content": "data-[chips=true]:min-w-(--anchor-width)",
  "cn-combobox-item": "w-full",
  "cn-dialog-content": "-translate-x-1/2",
  "cn-dialog-content-aria": "-translate-x-1/2",
  "cn-drawer-overlay": "fixed",
  "cn-drawer-swipe-handle": "flex",
  "cn-dropdown-menu-content": "overflow-x-hidden overflow-y-auto",
  "cn-field": "w-full",
  "cn-input": "file:border-0 file:bg-transparent",
  "cn-input-group": "has-[>textarea]:h-auto",
  "cn-item": "focus-visible:border-ring",
  "cn-item-description": "[&>a:hover]:text-primary",
  "cn-kbd": "inline-flex",
  "cn-kbd-group": "inline-flex",
  "cn-marker": "w-full",
  "cn-navigation-menu-content": "w-auto duration-[0.35s]",
  "cn-navigation-menu-trigger": "h-9",
  "cn-questionnaire-actions": "min-h-11",
  "cn-questionnaire-choice-indicator": "group-data-[type=radio]/questionnaire-choice:rounded-full",
  "cn-questionnaire-choice-shortcut": "hidden",
  "cn-resizable-handle": "after:-translate-x-1/2 aria-[orientation=horizontal]:after:translate-x-0",
  "cn-select-item": "w-full",
  "cn-select-scroll-down-button": "w-full",
  "cn-select-scroll-up-button": "w-full",
  "cn-select-trigger": "w-fit",
  "cn-sidebar-menu-sub": "flex",
  "cn-sidebar-menu-sub-button": "-translate-x-px",
  "cn-sidebar-rail": "w-4",
  "cn-slider-track": "data-horizontal:w-full data-vertical:h-full",
  "cn-tabs-list": "group-data-vertical/tabs:h-fit",
  "cn-tabs-trigger": "flex-1 group-data-vertical/tabs:w-full hover:text-foreground [&_svg]:shrink-0",
  "cn-textarea": "field-sizing-content min-h-16",
  "cn-toast": "focus-visible:ring-ring/50",
  "cn-toast-viewport": "inset-x-4",
  "cn-toggle-group": "gap-[--spacing(var(--gap))] relative",
  "cn-toggle-group-item": "group-data-[spacing=0]/toggle-group:relative group-data-indicator/toggle-group:aria-pressed:bg-transparent! group-data-indicator/toggle-group:data-[state=on]:bg-transparent!"
}
