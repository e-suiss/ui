{
  "name": "@esuiss/web",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "registry": "node scripts/build-registry.mjs",
    "registry:check": "node scripts/build-registry.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:visual": "VISUAL=1 vitest run --project stories --changed origin/main",
    "test:visual:all": "VISUAL=1 vitest run --project stories",
    "test:visual:rtl": "RTL=1 VISUAL=1 vitest run --project stories",
    "test:a11y": "rm -rf .vitest/a11y .vitest/a11y-focus && A11Y=1 vitest run --project stories; node scripts/a11y-report.mjs",
    "test:motion": "rm -rf .vitest/motion && MOTION=1 vitest run --project stories; node scripts/a11y-report.mjs",
    "test:text": "rm -rf .vitest/text && TEXT=1 vitest run --project stories; node scripts/a11y-report.mjs",
    "test:browsers": "BROWSERS=1 vitest run --project 'stories*'",
    "test:mobile": "MOBILE=1 vitest run --project 'stories*'",
    "test:responsive": "rm -rf .vitest/responsive && for width in 320 768 1440; do WIDTH=$width vitest run --project stories; done; node scripts/a11y-report.mjs",
    "test:rtl": "rm -rf .vitest/rtl && RTL=1 vitest run --project stories; node scripts/check-rtl.mjs; node scripts/a11y-report.mjs",
    "test:long-text": "rm -rf .vitest/long-text && LONG_TEXT=1 vitest run --project stories; node scripts/a11y-report.mjs",
    "size": "size-limit",
    "test:vitals": "storybook build -o storybook-static --quiet && node scripts/web-vitals.mjs",
    "test:perf": "rm -rf .vitest/perf && PERF=1 vitest run --project perf; node scripts/perf-report.mjs",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "check": "biome check --error-on-warnings ."
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@phosphor-icons/react": "catalog:",
    "class-variance-authority": "catalog:",
    "cmdk": "catalog:",
    "cn": "catalog:",
    "embla-carousel-react": "catalog:",
    "input-otp": "catalog:",
    "react": "catalog:",
    "react-day-picker": "catalog:",
    "react-dom": "catalog:",
    "react-resizable-panels": "catalog:",
    "recharts": "catalog:"
  },
  "devDependencies": {
    "@esuiss/tailwind": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@size-limit/esbuild": "^14.1.0",
    "@size-limit/file": "^14.1.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-themes": "^10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser": "5.0.3",
    "@vitest/browser-playwright": "5.0.3",
    "axe-core": "4.13.0",
    "playwright": "^1.63.0",
    "size-limit": "^14.1.0",
    "storybook": "^10.6.1",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.1",
    "vitest": "5.0.3",
    "vitest-browser-react": "2.3.0"
  }
}
