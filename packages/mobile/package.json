{
  "name": "@esuiss/mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "generate": "uniwind generate-artifacts --css ./global.css --dts ./uniwind-types.d.ts",
    "registry": "node scripts/build-registry.mjs",
    "registry:check": "node scripts/build-registry.mjs --check --schema && node scripts/build-nativewind.mjs --check && node scripts/build-tokens.mjs --check && node scripts/build-icons.mjs --check",
    "icons": "node scripts/build-icons.mjs",
    "typecheck": "pnpm generate && tsc --noEmit && tsc --noEmit -p nativewind && tsc --noEmit -p stylesheet",
    "nativewind": "node scripts/build-nativewind.mjs",
    "nativewind:check": "node scripts/build-nativewind.mjs --check",
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "styles": "node scripts/derive-styles.mjs",
    "visual:android": "node scripts/visual-android.mjs",
    "visual:ios": "node scripts/visual-ios.mjs",
    "visual:swiftui": "node scripts/visual-swiftui.mjs"
  },
  "dependencies": {
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "expo": "~57.0.26",
    "expo-system-ui": "~57.0.4",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "catalog:",
    "uniwind": "^1.12.0"
  },
  "devDependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react-native": "1.0.16",
    "@tabler/icons": "3.49.0",
    "@tabler/icons-react-native": "3.49.0",
    "@types/node": "catalog:",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "ajv": "^8.20.0",
    "expo-clipboard": "~57.0.2",
    "expo-haptics": "~57.0.3",
    "lucide-react-native": "1.57.0",
    "lucide-static": "1.57.0",
    "nativewind": "4.2.7",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.28",
    "react-dom": "19.2.3",
    "react-native-view-shot": "5.1.0",
    "remixicon": "4.9.1",
    "typescript": "catalog:"
  }
