{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/*.mjs"]
    },
    "packages/web": {
      "entry": [
        "components/ui/*.tsx",
        "components/patterns/*.tsx",
        "components/interactions/*.tsx",
        "components/charts/*.tsx",
        "components/blocks/*.tsx",
        "hooks/*.ts",
        "lib/*.ts",
        "scripts/*.mjs",
        "tests/*-setup.ts",
        "examples/*.tsx"
      ],
      "project": [
        "components/**/*.{ts,tsx}",
        "hooks/**/*.ts",
        "lib/**/*.ts",
        "scripts/**/*.mjs",
        "styles/**/*.css",
        "examples/*.tsx",
        "tests/render-example.tsx",
        "tests/examples/*.test.tsx"
      ]
    },
    "packages/cli": {
      "entry": ["tests/**/*.test.mjs"],
      "project": ["lib/**/*.mjs", "tests/**/*.mjs"]
    },
    "packages/tailwind": {},
    "packages/mobile": {
      "entry": [
        "uniwind/components/**/*.tsx",
        "scripts/*.mjs",
        "stories/**/*.stories.tsx",
        ".rnstorybook/*.{ts,tsx}",
        "nativewind/components/**/*.tsx",
        "stylesheet/components/**/*.{ts,tsx}",
        "components/primitives/*.{ts,tsx}",
        "App.web.tsx"
      ],
      "project": [
        "uniwind/**/*.{ts,tsx}",
        "scripts/**/*.mjs",
        ".rnstorybook/**/*.{ts,tsx}",
        "stories/**/*.tsx",
        "*.{ts,tsx}",
        "nativewind/**/*.tsx",
        "stylesheet/**/*.{ts,tsx}",
        "components/primitives/*.{ts,tsx}"
      ],
      "paths": {
        "@/components/primitives/*": ["./components/primitives/*"],
        "@/components/*": [
          "./uniwind/components/*",
          "./stylesheet/components/*"
        ]
      },
      "ignoreDependencies": ["expo-updates"],
      "metro": false
    }
  },
  "ignoreWorkspaces": ["apps/*", "packages/tokens"]
}
