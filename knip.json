{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "uniwind/components/ui/*.tsx",
    "scripts/*.mjs",
    "packages/cli/index.mjs",
    "stories/**/*.stories.tsx",
    ".rnstorybook/*.{ts,tsx}",
    "nativewind/components/ui/*.tsx",
    "stylesheet/components/ui/*.{ts,tsx}"
  ],
  "project": [
    "uniwind/**/*.{ts,tsx}",
    "scripts/**/*.mjs",
    "packages/cli/**/*.mjs",
    ".rnstorybook/**/*.{ts,tsx}",
    "stories/**/*.tsx",
    "*.{ts,tsx}",
    "nativewind/**/*.tsx",
    "stylesheet/**/*.{ts,tsx}"
  ],
  "ignoreDependencies": ["expo-updates"],
  "paths": {
    "@/components/*": ["./uniwind/components/*", "./stylesheet/components/*"]
  }
}
