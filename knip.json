{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "components/ui/*.tsx",
        "components/patterns/*.tsx",
        "components/interactions/*.tsx",
        "components/charts/*.tsx",
        "components/blocks/*.tsx",
        "hooks/*.ts",
        "scripts/*.mjs",
        "packages/cli/index.mjs"
      ],
      "project": [
        "components/**/*.{ts,tsx}",
        "hooks/**/*.ts",
        "scripts/**/*.mjs",
        "packages/cli/**/*.mjs",
        ".storybook/**/*.{ts,tsx}",
        "styles/**/*.css",
        ".storybook/**/*.css",
        "stories/**/*.{tsx,mdx}"
      ]
    },
    "packages/tailwind": {}
  }
}
