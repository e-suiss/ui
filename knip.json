{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "uniwind/components/**/*.tsx",
    "scripts/*.mjs",
    "packages/cli/index.mjs",
    "stories/**/*.stories.tsx",
    ".rnstorybook/*.{ts,tsx}",
    "nativewind/components/**/*.tsx",
    "stylesheet/components/**/*.{ts,tsx}",
    "components/primitives/*.{ts,tsx}"
  ],
  "project": [
    "uniwind/**/*.{ts,tsx}",
    "scripts/**/*.mjs",
    "packages/cli/**/*.mjs",
    ".rnstorybook/**/*.{ts,tsx}",
    "stories/**/*.tsx",
    "*.{ts,tsx}",
    "nativewind/**/*.tsx",
    "stylesheet/**/*.{ts,tsx}",
    "components/primitives/*.{ts,tsx}"
  ],
  "ignoreDependencies": ["expo-updates"],
  "paths": {
    "@/components/primitives/*": ["./components/primitives/*"],
    "@/components/*": ["./uniwind/components/*", "./stylesheet/components/*"]
  }
}
