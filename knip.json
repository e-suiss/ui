{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/*.mjs"]
    },
    "packages/web": {
      "entry": [
        "components/ui/*.tsx",
        "components/patterns/*.tsx",
        "components/interactions/*.tsx",
        "components/charts/*.tsx",
        "components/blocks/*.tsx",
        "hooks/*.ts",
        "lib/*.{ts,tsx}",
        "scripts/*.mjs",
        "tests/*-setup.ts",
        "examples/*.tsx",
        "bases/*/components/**/*.tsx",
        "bases/*/examples/*.tsx",
        "site/*.tsx"
      ],
      "project": [
        "components/**/*.{ts,tsx}",
        "hooks/**/*.ts",
        "lib/**/*.{ts,tsx}",
        "scripts/**/*.mjs",
        "styles/**/*.css",
        "examples/*.tsx",
        "app/**/*.tsx",
        "tests/render-example.tsx",
        "tests/base.ts",
        "tests/examples/*.test.tsx",
        "bases/**/*.{ts,tsx}",
        "site/**/*.{tsx,css}"
      ],
      "ignore": [
        "styles/generated/*.css",
        "styles/style-suiss*.css",
        "styles/vendor/*.css"
      ]
    },
    "packages/cli": {
      "entry": ["tests/**/*.test.mjs"],
      "project": ["lib/**/*.mjs", "tests/**/*.mjs"]
    },
    "packages/mobile": {
      "entry": [
        "uniwind/components/**/*.tsx",
        "scripts/*.mjs",
        "stories/**/*.stories.tsx",
        ".rnstorybook/*.{ts,tsx}",
        "nativewind/components/**/*.tsx",
        "stylesheet/components/**/*.{ts,tsx}",
        "components/primitives/*.{ts,tsx}",
        "App.web.tsx",
        "icons/rn/*.tsx"
      ],
      "project": [
        "uniwind/**/*.{ts,tsx}",
        "scripts/**/*.mjs",
        ".rnstorybook/**/*.{ts,tsx}",
        "stories/**/*.tsx",
        "*.{ts,tsx}",
        "nativewind/**/*.tsx",
        "stylesheet/**/*.{ts,tsx}",
        "components/primitives/*.{ts,tsx}",
        "icons/rn/*.tsx"
      ],
      "paths": {
        "@/components/primitives/*": ["./components/primitives/*"],
        "@/components/*": [
          "./uniwind/components/*",
          "./stylesheet/components/*"
        ]
      },
      "metro": false,
      "ignoreDependencies": [
        "expo-updates",
        "@tabler/icons",
        "lucide-static",
        "remixicon"
      ]
    },
    "apps/www": {
      "entry": ["lib/image-loader.ts"],
      "ignoreDependencies": ["@esuiss/web", "@fontsource/inter"]
    },
    "apps/ui": {
      "entry": ["components/site/icon-placeholder.tsx", "scripts/*.mjs"],
      "ignore": ["public/**"],
      "ignoreDependencies": ["@esuiss/web", "@fontsource/inter"]
    }
  },
  "ignoreWorkspaces": ["packages/tokens"],
  "ignoreIssues": {
    "apps/ui/components/site/platform.tsx": ["exports"],
    "apps/ui/lib/code-options.ts": ["exports"],
    "apps/ui/lib/highlight.ts": ["exports"],
    "apps/ui/lib/dependencies.ts": ["types"]
  }
}
