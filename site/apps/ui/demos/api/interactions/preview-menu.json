      "extends": [
        "ContextMenuPrimitive.Popup.Props"
      ],
      "props": [
        {
          "name": "preview",
          "type": "React.ReactNode",
          "required": false
        },
        {
          "name": "previewClassName",
          "type": "string",
          "required": false
        }
