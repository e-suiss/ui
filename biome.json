{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/registry.json",
      "!pnpm-lock.yaml",
      "!apps/ui/public/live",
      "!packages/mobile/ios",
      "!packages/mobile/android",
      "!packages/mobile/uniwind-types.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "quoteStyle": "double",
      "trailingCommas": "es5"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "useSemanticElements": "off"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "noUselessElse": "error",
        "useCollapsedElseIf": "error",
        "useTemplate": "error",
        "useAtIndex": "error",
        "useForOf": "error",
        "noUnusedTemplateLiteral": "error",
        "useConsistentArrayType": "error",
        "noInferrableTypes": "error",
        "useFragmentSyntax": "error",
        "useShorthandAssign": "error",
        "useNumberNamespace": "error",
        "useDefaultSwitchClause": "error",
        "noNestedTernary": "error"
      },
      "suspicious": {
        "noEmptyBlockStatements": "error",
        "useAwait": "error",
        "noEvolvingTypes": "error",
        "noConsole": "error"
      },
      "correctness": {
        "noUnusedFunctionParameters": "error",
        "noUndeclaredVariables": "error",
        "useJsxKeyInIterable": "error",
        "noRenderReturnValue": "error",
        "noNestedComponentDefinitions": "error"
      },
      "complexity": {
        "noUselessStringConcat": "error",
        "noForEach": "error",
        "noUselessUndefinedInitialization": "error"
      },
      "performance": {
        "noDelete": "error",
        "noReExportAll": "error",
        "useTopLevelRegex": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/cli/**",
        "scripts/**",
        "packages/web/scripts/**",
        "packages/mobile/scripts/**",
        "apps/ui/scripts/**",
        "packages/web/tests/**/*.mjs"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/web/hooks/use-message-scroller.ts",
        "packages/web/hooks/use-questionnaire.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "useExhaustiveDependencies": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/web/components/ui/label.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/web/components/ui/input-group.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "useKeyWithClickEvents": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/web/components/ui/message-scroller.tsx",
        "packages/web/bases/*/components/ui/message-scroller.tsx",
        "packages/web/bases/*/components/interactions/preview-menu.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noStaticElementInteractions": "off",
            "useAriaPropsSupportedByRole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/web/components/ui/sidebar.tsx",
        "packages/web/bases/*/components/ui/sidebar.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noDocumentCookie": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/web/components/ui/slider.tsx",
        "packages/web/bases/*/components/ui/slider.tsx",
        "packages/web/bases/*/examples/**",
        "packages/web/examples/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/web/examples/**",
        "packages/web/bases/*/examples/**"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useAnchorContent": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/web/styles/globals.css",
        "apps/ui/app/globals.css"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/web/components/ui/theme.tsx"],
      "linter": {
        "rules": {
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/mobile/styles/uniwind.css",
        "packages/mobile/registry/uniwind/theme-suiss.css"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noDuplicateCustomProperties": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/mobile/styles/nativewind.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": "off"
          }
        }
      }
    }
  ]
}
