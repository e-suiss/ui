{
  "name": "esuiss-ui",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "registry": "node scripts/build-registry.mjs",
    "registry:check": "node scripts/build-registry.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:visual": "VISUAL=1 vitest run --project stories",
    "test:a11y": "rm -rf .vitest/a11y .vitest/a11y-focus && A11Y=1 vitest run --project stories; node scripts/a11y-report.mjs",
    "test:motion": "rm -rf .vitest/motion && MOTION=1 vitest run --project stories; node scripts/a11y-report.mjs",
    "test:text": "rm -rf .vitest/text && TEXT=1 vitest run --project stories; node scripts/a11y-report.mjs",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "release": "node scripts/release.mjs",
    "check": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "knip": "knip",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.14.1",
    "recharts": "3.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@esuiss/tailwind": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/questrial": "^5.3.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-themes": "^10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser": "5.0.3",
    "@vitest/browser-playwright": "5.0.3",
    "axe-core": "4.13.0",
    "knip": "6.38.0",
    "lefthook": "2.1.15",
    "lint-staged": "17.6.0",
    "playwright": "^1.63.0",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vite": "^8.3.1",
    "vitest": "5.0.3",
    "vitest-browser-react": "2.3.0"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx,json,jsonc,css}": "biome check --write --error-on-warnings --no-errors-on-unmatched --files-ignore-unknown=true"
  }
}
