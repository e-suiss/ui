{
  "name": "esuiss-uim",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "main": "index.ts",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "generate": "uniwind generate-artifacts --css ./.rnstorybook/global.css --dts ./uniwind-types.d.ts && sb-rn-get-stories",
    "registry": "node scripts/build-registry.mjs",
    "registry:check": "node scripts/build-registry.mjs --check",
    "typecheck": "pnpm generate && tsc --noEmit && tsc --noEmit -p nativewind && tsc --noEmit -p stylesheet",
    "release": "node scripts/release.mjs",
    "check": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "knip": "knip",
    "prepare": "lefthook install",
    "nativewind": "node scripts/build-nativewind.mjs",
    "nativewind:check": "node scripts/build-nativewind.mjs --check",
    "theme": "node scripts/build-theme.mjs",
    "theme:check": "node scripts/build-theme.mjs --check"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "expo": "~57.0.26",
    "expo-system-ui": "~57.0.4",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "@storybook/addon-ondevice-actions": "10.6.0",
    "@storybook/addon-ondevice-controls": "10.6.0",
    "@storybook/react-native": "10.6.0",
    "@types/node": "^26.6.3",
    "@types/react": "~19.2.18",
    "knip": "6.38.0",
    "lefthook": "2.1.15",
    "lint-staged": "17.6.0",
    "nativewind": "4.2.7",
    "storybook": "10.6.0",
    "typescript": "~6.0.3"
  },
  "type": "module",
  "lint-staged": {
    "*.{js,mjs,ts,tsx,json,jsonc,css}": "biome check --write --error-on-warnings --no-errors-on-unmatched --files-ignore-unknown=true"
  }
}
