{
  "name": "esuiss",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "turbo run dev --filter=./apps/*",
    "build": "turbo run build --filter=./apps/* && node scripts/site.mjs",
    "deploy": "wrangler deploy",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "registry": "turbo run registry",
    "registry:check": "turbo run registry:check",
    "check": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "knip": "pnpm --filter @esuiss/mobile generate && knip",
    "release": "node scripts/release.mjs",
    "compat": "node scripts/compat.mjs",
    "compat:rn": "node scripts/compat-rn.mjs",
    "matrix": "node scripts/matrix.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "knip": "6.38.0",
    "lefthook": "2.1.15",
    "lint-staged": "17.6.0",
    "turbo": "^2.11.7",
    "wrangler": "4.146.0"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx,json,jsonc,css}": "biome check --write --error-on-warnings --no-errors-on-unmatched --files-ignore-unknown=true"
  }
}
