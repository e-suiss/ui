{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {},
    "registry": {
      "cache": false
    },
    "registry:check": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@esuiss/site#registry": {
      "cache": false,
      "dependsOn": ["@esuiss/web#registry", "@esuiss/mobile#registry"]
    },
    "@esuiss/site#registry:check": {
      "dependsOn": [
        "@esuiss/web#registry:check",
        "@esuiss/mobile#registry:check"
      ]
    }
  },
  "globalPassThroughEnv": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ZONE_ID"]
}
